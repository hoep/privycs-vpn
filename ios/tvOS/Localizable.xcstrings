    "tv.rules.autoconnect_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the VPN connected automatically on any network, even after a reboot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält das VPN automatisch in jedem Netzwerk verbunden, auch nach einem Neustart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene la VPN conectada automáticamente en cualquier red, incluso tras reiniciar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintient le VPN connecté automatiquement sur tout réseau, même après un redémarrage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene la VPN connessa automaticamente su qualsiasi rete, anche dopo un riavvio."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém a VPN ligada automaticamente em qualquer rede, mesmo após reiniciar."
          }
        }
      }
    },
    "tv.rules.wifi_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Empty = any network. Otherwise the VPN connects only on these WiFi names and disconnects elsewhere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer = jedes Netzwerk. Sonst verbindet sich das VPN nur in diesen WLANs und trennt anderswo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vacío = cualquier red. Si no, la VPN se conecta solo en estas redes WiFi y se desconecta en otras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vide = tout réseau. Sinon le VPN se connecte uniquement sur ces réseaux WiFi et se déconnecte ailleurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoto = qualsiasi rete. Altrimenti la VPN si connette solo su queste reti WiFi e si disconnette altrove."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vazio = qualquer rede. Caso contrário, a VPN liga-se apenas nestas redes WiFi e desliga-se noutras."
          }
        }
      }
    },
