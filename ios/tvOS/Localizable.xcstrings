        "it" : { "stringUnit" : { "state" : "translated", "value" : "Il collegamento tramite codice non è ancora disponibile. Inserisci invece l’URL del gateway e il token." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "A associação por código ainda não está disponível. Introduza o URL do gateway e o token." } }
