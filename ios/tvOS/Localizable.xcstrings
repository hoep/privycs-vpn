    "tv.settings.backup_desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import a config or restore connections from another device over your local network."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiere eine Konfig oder stelle Verbindungen von einem anderen Gerät über das lokale Netzwerk wieder her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa una configuración o restaura conexiones desde otro dispositivo por la red local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez une config ou restaurez des connexions depuis un autre appareil via le réseau local."
          }
        },
        "it": {
