    "DNS servers for this pool. Takes precedence over the global setting. Empty = use the global setting.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS-Server für diesen Pool. Hat Vorrang vor der globalen Einstellung. Leer = globale Einstellung verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS servers for this pool. Takes precedence over the global setting. Empty = use the global setting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Servidores DNS para este grupo. Tienen prioridad sobre el ajuste global. Vacío = usar el ajuste global."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveurs DNS pour ce pool. Prioritaires sur le réglage global. Vide = utiliser le réglage global."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Server DNS per questo pool. Hanno la precedenza sull'impostazione globale. Vuoto = usa l'impostazione globale."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Servidores DNS para este grupo. Têm prioridade sobre a definição global. Vazio = usar a definição global."
          }
        }
      }
    },
    "DNS servers used while connected (WireGuard / AmneziaWG / OpenVPN). Per-connection and per-pool overrides take precedence.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS-Server, die bei Verbindung verwendet werden (WireGuard / AmneziaWG / OpenVPN). Verbindungs- und Pool-spezifische Überschreibungen haben Vorrang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS servers used while connected (WireGuard / AmneziaWG / OpenVPN). Per-connection and per-pool overrides take precedence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Servidores DNS usados mientras está conectado (WireGuard / AmneziaWG / OpenVPN). Las anulaciones por conexión y por grupo tienen prioridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveurs DNS utilisés une fois connecté (WireGuard / AmneziaWG / OpenVPN). Les remplacements par connexion et par pool sont prioritaires."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Server DNS usati durante la connessione (WireGuard / AmneziaWG / OpenVPN). Le sostituzioni per connessione e per pool hanno la precedenza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Servidores DNS usados quando ligado (WireGuard / AmneziaWG / OpenVPN). As substituições por ligação e por grupo têm prioridade."
          }
        }
      }
    },
