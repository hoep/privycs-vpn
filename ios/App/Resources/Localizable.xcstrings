    "Encrypts the backup (AES-256-GCM). You'll need the same passphrase to restore — there is no recovery if you forget it. Backups are cross-platform with the Android and Desktop apps.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypts the backup (AES-256-GCM). You'll need the same passphrase to restore — there is no recovery if you forget it. Backups are cross-platform with the Android and Desktop apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsselt das Backup (AES-256-GCM). Zum Wiederherstellen brauchst du dieselbe Passphrase — es gibt keine Wiederherstellung, wenn du sie vergisst. Backups sind plattformübergreifend mit den Android- und Desktop-Apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cifra la copia de seguridad (AES-256-GCM). Necesitarás la misma contraseña para restaurar — no hay recuperación si la olvidas. Las copias son compatibles con las apps de Android y Escritorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiffre la sauvegarde (AES-256-GCM). Vous aurez besoin de la même phrase secrète pour restaurer — aucune récupération possible si vous l'oubliez. Les sauvegardes sont compatibles avec les apps Android et Bureau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cifra il backup (AES-256-GCM). Per ripristinare serve la stessa passphrase — non c'è recupero se la dimentichi. I backup sono multipiattaforma con le app Android e Desktop."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cifra a cópia de segurança (AES-256-GCM). Precisará da mesma frase-passe para restaurar — não há recuperação se a esquecer. As cópias são compatíveis com as apps Android e Desktop."
          }
        }
      }
    },
    "Ethernet": {
      "localizations": {
        "en": {
          "stringUnit": {
