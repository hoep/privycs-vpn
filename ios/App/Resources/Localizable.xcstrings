    "Unlimited configs, pool rotation, geo-nearest routing, and more — one-time purchase, no subscription.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlimited configs, pool rotation, geo-nearest routing, and more — one-time purchase, no subscription."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbegrenzte Configs, Pool-Rotation, geografisch-nächstes Routing und mehr — Einmalkauf, kein Abo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configs ilimitadas, rotación de grupos, enrutamiento al más cercano y más — compra única, sin suscripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configs illimitées, rotation de pool, routage au plus proche et plus — achat unique, sans abonnement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Config illimitate, rotazione dei pool, instradamento al più vicino e altro — acquisto una tantum, nessun abbonamento."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Configs ilimitadas, rotação de grupos, encaminhamento ao mais próximo e mais — compra única, sem subscrição."
          }
        }
      }
    },
