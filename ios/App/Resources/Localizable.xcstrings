    "Probes a reachable target through the tunnel and shows a health pill on the Connect screen. Foreground-only on iOS.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft ein erreichbares Ziel durch den Tunnel und zeigt eine Zustandsanzeige im Verbinden-Bildschirm. Auf iOS nur im Vordergrund."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Probes a reachable target through the tunnel and shows a health pill on the Connect screen. Foreground-only on iOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sondea un objetivo accesible a través del túnel y muestra un indicador de estado en la pantalla Conectar. Solo en primer plano en iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonde une cible joignable à travers le tunnel et affiche un indicateur d'état sur l'écran Connexion. Au premier plan uniquement sur iOS."
          }
        },
        "it": {
