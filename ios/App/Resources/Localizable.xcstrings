    "License keys are ed25519-signed and verified offline. Paste the entire string including the .signature.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lizenzschlüssel sind ed25519-signiert und werden offline verifiziert. Füge die gesamte Zeichenkette inklusive der .signature ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "License keys are ed25519-signed and verified offline. Paste the entire string including the .signature."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves de licencia están firmadas con ed25519 y se verifican sin conexión. Pega la cadena completa incluida la .signature."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés de licence sont signées en ed25519 et vérifiées hors ligne. Collez la chaîne entière, y compris la .signature."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiavi di licenza sono firmate ed25519 e verificate offline. Incolla l'intera stringa inclusa la .signature."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As chaves de licença são assinadas com ed25519 e verificadas offline. Cole a string inteira incluindo a .signature."
          }
        }
      }
    },
