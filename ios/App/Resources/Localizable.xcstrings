    "Kill Switch routes IPv6 into the tunnel so a v4-only server can't leak your real IPv6 address. Turning it off allows IPv6 traffic outside the VPN.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kill Switch leitet IPv6 in den Tunnel, damit ein reiner v4-Server deine echte IPv6-Adresse nicht preisgibt. Ausschalten erlaubt IPv6-Verkehr außerhalb des VPN."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kill Switch routes IPv6 into the tunnel so a v4-only server can't leak your real IPv6 address. Turning it off allows IPv6 traffic outside the VPN."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Kill Switch enruta IPv6 al túnel para que un servidor solo v4 no filtre tu dirección IPv6 real. Desactivarlo permite tráfico IPv6 fuera de la VPN."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Kill Switch achemine l'IPv6 dans le tunnel afin qu'un serveur v4 uniquement ne divulgue pas votre vraie adresse IPv6. Le désactiver autorise le trafic IPv6 hors du VPN."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Kill Switch instrada l'IPv6 nel tunnel così un server solo v4 non può rivelare il tuo vero indirizzo IPv6. Disattivarlo consente il traffico IPv6 fuori dalla VPN."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Kill Switch encaminha o IPv6 para o túnel para que um servidor só v4 não revele o seu endereço IPv6 real. Desativá-lo permite tráfego IPv6 fora da VPN."
          }
        }
      }
    },
