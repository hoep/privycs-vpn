    "settings.crash_reports": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonymous crash reports"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anonyme Absturzberichte"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Informes de fallo anónimos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapports de plantage anonymes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segnalazioni di crash anonime"
          }
        },
        "pt": {
          "stringUnit": {
