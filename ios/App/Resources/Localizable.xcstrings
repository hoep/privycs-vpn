    "Supported: .conf (WireGuard/AmneziaWG), .ovpn (OpenVPN), .sswan / .mobileconfig (IPSec). Configure a gateway in Settings to pull remote configs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterstützt: .conf (WireGuard/AmneziaWG), .ovpn (OpenVPN), .sswan / .mobileconfig (IPSec). Konfiguriere ein Gateway in den Einstellungen, um Remote-Konfigurationen abzurufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supported: .conf (WireGuard/AmneziaWG), .ovpn (OpenVPN), .sswan / .mobileconfig (IPSec). Configure a gateway in Settings to pull remote configs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compatibles: .conf (WireGuard/AmneziaWG), .ovpn (OpenVPN), .sswan / .mobileconfig (IPSec). Configura un gateway en Ajustes para descargar configuraciones remotas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pris en charge : .conf (WireGuard/AmneziaWG), .ovpn (OpenVPN), .sswan / .mobileconfig (IPSec). Configurez une passerelle dans les Réglages pour récupérer des configurations distantes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Supportati: .conf (WireGuard/AmneziaWG), .ovpn (OpenVPN), .sswan / .mobileconfig (IPSec). Configura un gateway in Impostazioni per scaricare configurazioni remote."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Suportados: .conf (WireGuard/AmneziaWG), .ovpn (OpenVPN), .sswan / .mobileconfig (IPSec). Configura um gateway nas Definições para obter configurações remotas."
          }
        }
      }
    },
    "Supported: .conf, .ovpn, .sswan / .mobileconfig. Or pull your configs from the gateway.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterstützt: .conf, .ovpn, .sswan / .mobileconfig. Oder rufe deine Konfigurationen vom Gateway ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supported: .conf, .ovpn, .sswan / .mobileconfig. Or pull your configs from the gateway."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compatibles: .conf, .ovpn, .sswan / .mobileconfig. O descarga tus configuraciones desde el gateway."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pris en charge : .conf, .ovpn, .sswan / .mobileconfig. Ou récupérez vos configurations depuis la passerelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Supportati: .conf, .ovpn, .sswan / .mobileconfig. Oppure scarica le tue configurazioni dal gateway."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Suportados: .conf, .ovpn, .sswan / .mobileconfig. Ou obtém as tuas configurações a partir do gateway."
          }
        }
      }
    },
