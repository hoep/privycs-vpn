            "state": "translated",
            "value": "Wenn aus, wird keine Regel ausgewertet — das VPN ist vollständig manuell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando está desactivado, no se evalúa ninguna regla — la VPN es totalmente manual."
