      }
    },
    "When off, no rule is evaluated — VPN is fully manual.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aus, wird keine Regel ausgewertet — das VPN ist vollständig manuell."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, no rule is evaluated — VPN is fully manual."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando está desactivado, no se evalúa ninguna regla — la VPN es totalmente manual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque désactivé, aucune règle n'est évaluée — le VPN est entièrement manuel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando disattivato, nessuna regola viene valutata — la VPN è completamente manuale."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando desativado, nenhuma regra é avaliada — a VPN é totalmente manual."
          }
        }
      }
    },
