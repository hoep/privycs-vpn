          }
        }
      }
    },
    "settings.crash_reports_desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help improve Privycs by sending anonymous crash reports. SSIDs, API keys, IPs and file paths are redacted on-device before upload to our self-hosted backend."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilf Privycs zu verbessern durch anonyme Absturzberichte. SSIDs, API-Keys, IPs und Datei-Pfade werden vor dem Upload zu unserem self-hosted Backend on-device redaktiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuda a mejorar Privycs enviando informes anónimos de fallo. SSIDs, claves API, IPs y rutas de archivos se redactan en el dispositivo antes de subirlos a nuestro backend propio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aidez à améliorer Privycs en envoyant des rapports de plantage anonymes. SSID, clés API, IPs et chemins de fichiers sont caviardés sur l’appareil avant l’envoi à notre backend auto-hébergé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiuta a migliorare Privycs inviando segnalazioni anonime di crash. SSID, chiavi API, IP e percorsi di file vengono oscurati sul dispositivo prima del caricamento sul nostro backend self-hosted."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajude a melhorar o Privycs enviando relatórios anónimos de falhas. SSIDs, chaves de API, IPs e caminhos de ficheiros são redigidos no dispositivo antes do envio para o nosso backend self-hosted."
          }
        }
      }
    },
