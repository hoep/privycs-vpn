<?xml version="1.0" encoding="utf-8"?>
<!--
    Minimal manifest for ics-openvpn integration. Upstream ships a much
    broader manifest with external-API services, a dedicated Application
    class, boot receiver, launch/disconnect/remote-action activities and
    activity-aliases. We drop all of that:

      - ICSOpenVPNApplication    -> we extend our own Application class
                                    (PrivycsApp). Its init work (notification
                                    channels + StatusListener) is replicated
                                    in PrivycsApp.onCreate().
      - LaunchVPN, DisconnectVPN -> user-facing activities we don't want in
        RemoteAction, etc.          the launcher or in recents.
      - OnBootReceiver           -> we have our own BootReceiver that knows
                                    about all three protocols.
      - ExternalOpenVPNService   -> exposes a public AIDL endpoint to other
        + GrantPermissionsActivity  apps; we don't want that attack surface.
      - keepVPNAlive             -> job service for the built-in keep-alive
                                    strategy; not used when we own the
                                    Application lifecycle.

    Two services and one permission hook are all we actually need.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- QUERY_ALL_PACKAGES: used by VpnProfile allow/deny-app selection. If
         the user never picks per-app split tunnel this is never read, but
         keeping it declared stops upstream code paths from crashing on
         PackageManager lookups. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application>
        <!-- The VpnService that actually owns the tun fd for OpenVPN.
             Runs in a separate :openvpn process to match upstream's memory
             layout and to isolate native crashes from the main app process. -->
        <service
            android:name="de.blinkt.openvpn.core.OpenVPNService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse"
            android:process=":openvpn">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
        </service>

        <!-- Internal Messenger-based IPC between OpenVPNService and the
             status bar UI. StatusListener binds to it from the main process
             so VpnStatus callbacks reach the UI. Keep it internal
             (exported=false) - it serves no purpose to other apps. -->
        <service
            android:name="de.blinkt.openvpn.core.OpenVPNStatusService"
            android:exported="false"
            android:process=":openvpn" />

        <!-- JobService OpenVPNService schedules UNCONDITIONALLY on every
             VPN start (OpenVPNService.java:678). Periodically re-launches
             the tunnel via VPNLaunchHelper.startOpenVpn if it dies. Without
             this entry JobScheduler.schedule() throws
             IllegalArgumentException at the first OpenVPN connect.
             Class name intentionally lowercase 'k' - matches the upstream
             class declaration. -->
        <service
            android:name="de.blinkt.openvpn.core.keepVPNAlive"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:process=":openvpn" />

        <!-- Activities OpenVPNService references via PendingIntent for
             notification actions (Cancel button -> DisconnectVPN) and for
             user-input prompts (encrypted private-key password -> LaunchVPN).
             The PendingIntents would be created in all cases; without manifest
             declarations clicking them throws ActivityNotFoundException.
             For our gateway-generated .ovpn configs the LaunchVPN path is
             normally never hit (inline keys are unencrypted) but declaring
             both hardens the integration. Labels/themes are inherited from
             the merged vendor resource set. -->
        <activity
            android:name="de.blinkt.openvpn.activities.DisconnectVPN"
            android:autoRemoveFromRecents="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=".DisconnectVPN"
            android:theme="@style/blinkt.dialog"
            android:exported="false" />

        <activity
            android:name="de.blinkt.openvpn.LaunchVPN"
            android:autoRemoveFromRecents="true"
            android:excludeFromRecents="true"
            android:taskAffinity=".LaunchVPN"
            android:theme="@style/blinkt.dialog"
            android:exported="false" />
    </application>

</manifest>
