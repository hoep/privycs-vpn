<?xml version="1.0" encoding="utf-8"?>
<!--
    Minimal manifest for ics-openvpn integration. All services run in the
    MAIN app process (no android:process="..." overrides). Upstream ics-
    openvpn isolates OpenVPNService in a `:openvpn` subprocess for native-
    crash containment, but that introduces a SharedPreferences cross-
    process sync bug with our connect-time profile creation pattern: the
    subprocess hits "Used x 101 tries to get current version (-1/1) of
    the profile" on fresh profiles because MODE_MULTI_PROCESS is
    deprecated and does not reliably reload the "vpnlist" StringSet
    between processes on Samsung Android 16. Running in-process shares
    the ProfileManager singleton and the problem disappears; the crash-
    isolation tradeoff is acceptable for our use-case (strongSwan native
    code already runs in the main process too).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- QUERY_ALL_PACKAGES: used by VpnProfile allow/deny-app selection. If
         the user never picks per-app split tunnel this is never read, but
         keeping it declared stops upstream code paths from crashing on
         PackageManager lookups. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application>
        <!-- The VpnService that actually owns the tun fd for OpenVPN.
             Runs in a separate :openvpn process to match upstream's memory
             layout and to isolate native crashes from the main app process. -->
        <service
            android:name="de.blinkt.openvpn.core.OpenVPNService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse"
>
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
        </service>

        <!-- Internal Messenger-based IPC between OpenVPNService and the
             status bar UI. StatusListener binds to it from the main process
             so VpnStatus callbacks reach the UI. Keep it internal
             (exported=false) - it serves no purpose to other apps. -->
        <service
            android:name="de.blinkt.openvpn.core.OpenVPNStatusService"
            android:exported="false"
 />

        <!-- Seeds GlobalPreferences.instance in the `:openvpn` subprocess
             before OpenVPNService.onStartCommand can reference it.
             ContentProvider.onCreate is one of the earliest Application
             lifecycle hooks AMS invokes (after attachBaseContext, before
             Application.onCreate completes). Declaring the provider with
             `android:process=":openvpn"` forces AMS to instantiate it in
             the subprocess that actually runs OpenVPNService, not just the
             main process. `initOrder` pushes this above any other
             provider from merged manifests. See
             de/blinkt/openvpn/core/PrivycsGlobalPrefsProvider.java. -->
        <provider
            android:name="de.blinkt.openvpn.core.PrivycsGlobalPrefsProvider"
            android:authorities="${applicationId}.openvpn.prefs.seed"
            android:exported="false"
            android:initOrder="9999"
 />

        <!-- JobService OpenVPNService schedules UNCONDITIONALLY on every
             VPN start (OpenVPNService.java:678). Periodically re-launches
             the tunnel via VPNLaunchHelper.startOpenVpn if it dies. Without
             this entry JobScheduler.schedule() throws
             IllegalArgumentException at the first OpenVPN connect.
             Class name intentionally lowercase 'k' - matches the upstream
             class declaration. -->
        <service
            android:name="de.blinkt.openvpn.core.keepVPNAlive"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE"
 />

        <!-- Activities OpenVPNService references via PendingIntent for
             notification actions (Cancel button -> DisconnectVPN) and for
             user-input prompts (encrypted private-key password -> LaunchVPN).
             The PendingIntents would be created in all cases; without manifest
             declarations clicking them throws ActivityNotFoundException.
             For our gateway-generated .ovpn configs the LaunchVPN path is
             normally never hit (inline keys are unencrypted) but declaring
             both hardens the integration. Labels/themes are inherited from
             the merged vendor resource set. -->
        <activity
            android:name="de.blinkt.openvpn.activities.DisconnectVPN"
            android:autoRemoveFromRecents="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=".DisconnectVPN"
            android:theme="@style/blinkt.dialog"
            android:exported="false" />

        <activity
            android:name="de.blinkt.openvpn.LaunchVPN"
            android:autoRemoveFromRecents="true"
            android:excludeFromRecents="true"
            android:taskAffinity=".LaunchVPN"
            android:theme="@style/blinkt.dialog"
            android:exported="false" />
    </application>

</manifest>
