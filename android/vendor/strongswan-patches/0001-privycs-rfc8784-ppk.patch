+/* Privycs vendor extension: register a SHARED_PPK credential. */
+METHOD(android_creds_t, add_ppk, void,
+	private_android_creds_t *this, char *ppk_id, char *ppk_psk_hex)
+{
+	shared_key_t *shared_key;
+	identification_t *id;
+	chunk_t hex_in, raw;
+
+	if (!ppk_id || !ppk_psk_hex || !*ppk_id || !*ppk_psk_hex)
+	{
+		return;
+	}
+
+	hex_in = chunk_create(ppk_psk_hex, strlen(ppk_psk_hex));
+	raw = chunk_from_hex(hex_in, NULL);
+	if (!raw.len)
+	{
+		DBG1(DBG_CFG, "android_creds: PPK hex decode failed (id=%s, hex_len=%zu)",
+			 ppk_id, hex_in.len);
+		return;
+	}
+
+	shared_key = shared_key_create(SHARED_PPK, raw);
+	id = identification_create_from_string(ppk_id);
+
+	this->creds->add_shared(this->creds, shared_key, id, NULL);
+	DBG1(DBG_CFG, "android_creds: registered PPK id=%s (%zu bytes)", ppk_id, raw.len);
+}
