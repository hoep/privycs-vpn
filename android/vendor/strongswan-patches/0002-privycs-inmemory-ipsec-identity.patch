 	private byte[][] getUserCertificate() throws KeyChainException, InterruptedException, CertificateEncodingException
 	{
+		PrivycsCredentials.Entry privycs = mCurrentPrivycsCredentials;
+		if (privycs != null)
+		{	/* Leaf only. android_creds.c adds every further element of this
+			 * array as a TRUSTED cert, which would widen trust beyond the
+			 * profile's own remote.cert_chain. */
+			return new byte[][]{ privycs.leafDer };
+		}
 		ArrayList<byte[]> encodings = new ArrayList<byte[]>();
 		X509Certificate[] chain = KeyChain.getCertificateChain(getApplicationContext(), mCurrentUserCertificateAlias);
 		if (chain == null || chain.length == 0)
@@ -804,6 +860,11 @@
 	 */
 	private PrivateKey getUserKey() throws KeyChainException, InterruptedException
 	{
+		PrivycsCredentials.Entry privycs = mCurrentPrivycsCredentials;
+		if (privycs != null)
+		{
+			return privycs.key;
+		}
 		return KeyChain.getPrivateKey(getApplicationContext(), mCurrentUserCertificateAlias);
 	}
 
