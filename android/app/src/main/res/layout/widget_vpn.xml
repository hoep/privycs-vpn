<?xml version="1.0" encoding="utf-8"?>
<!--
    Privycs VPN home-screen widget - Connect-screen mirror (v5).

    v5 changes from v4 (v0.9.14.70 redesign per user request):

      - Connect button is a FIXED-SIZE 140dp square centered inside
        its row, instead of filling the row's match_parent width.
        Clicks ONLY register inside the square; whitespace around the
        button on wide widgets falls through to the root → opens the
        app, same as a tap on the traffic / VPN-IP cards. Pre-fix the
        toggle PendingIntent was on widget_button_container which
        included all that whitespace, and a single clumsy thumb-tap
        next to the disk would (dis)connect the tunnel.

      - Traffic cards collapsed: the sparkline used to live in its
        own 18dp row beneath label + total + speed (4 stacked rows).
        v5 puts the sparkline INLINE next to the speed value (single
        row), saving ~16dp per card row. Same data density, less
        vertical real-estate.

      - The 16dp saved goes back into the connect button's minHeight
        (120 → 140dp) so the visual button is bigger / easier to hit
        even on the smallest 4x3 widget cell.

    Click targets summary:
      - widget_button (fixed 140dp square)  → ACTION_TOGGLE
      - widget_protocol_wg/ipsec/ovpn       → ACTION_SWITCH_PROTOCOL
      - android.R.id.background (everywhere else) → open MainActivity

    Kill-Switch Sinkhole state: when KillSwitchManager reports
    SINKHOLE, the circle gets tinted red (#DC2626) and its icon swaps
    to ic_kill_switch_sinkhole — same as v4.

    RemoteViews whitelist constraints: LinearLayout, FrameLayout,
    ImageView, TextView allowed; no View/Space/CardView. Rounded
    cards are LinearLayouts with widget_card_background drawable.

    Root id = @android:id/background stays critical for Android 12+
    widget chrome (rounded corners, Material You tinting).
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_background">

    <!-- 1. Header row (v6 redesign per user request 2026-05-08):
         left = compact 96x96 connect button, right = vertical stack
         of status / uptime / connection-name. Replaces the v5 full-
         width-centered button which felt oversized on 4x3 widgets.
         The button-container id is kept so VpnWidget.kt's
         availableProtocols visibility toggle still resolves; the
         actual ACTION_TOGGLE PendingIntent is now attached to the
         inner widget_button FrameLayout (= the visible disc area).

         Whitespace between the right column's text rows is click-
         pass-through to the root @android:id/background → opens
         the app, same affordance as the traffic cards. Only the
         96dp disc dispatches ACTION_TOGGLE. -->
    <LinearLayout
        android:id="@+id/widget_button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:id="@+id/widget_button"
            android:layout_width="96dp"
            android:layout_height="96dp">

            <!-- Halo: soft radial glow behind the main circle. Drawn
                 first (= behind the solid disk). Visibility is
                 toggled from VpnWidget.kt: shown only when the
                 tunnel is up so disconnected widgets stay visually
                 quiet. -->
            <ImageView
                android:id="@+id/widget_button_halo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_margin="-8dp"
                android:src="@drawable/widget_button_halo"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:contentDescription="@null"
                android:adjustViewBounds="true" />

            <ImageView
                android:id="@+id/widget_button_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_button_circle"
                android:scaleType="fitCenter"
                android:contentDescription="@string/widget_description"
                android:adjustViewBounds="true" />

            <!-- v0.9.15.29: Icon + Status-Label vertically stacked
                 inside the circle, matching the in-app ConnectButton
                 (ConnectScreen.kt:1008-1080). The icon sits slightly
                 above center, "Connected" / "Connect" label sits
                 right below. Both tinted state-driven from
                 VpnWidget.kt. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/widget_button_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_protocol_wireguard"
                    android:scaleType="fitCenter"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_button_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/widget_connect"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FFFFFFFF"
                    android:singleLine="true" />
            </LinearLayout>
        </FrameLayout>

        <!-- Right column: status / uptime / connection-name dropdown -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <!-- v0.9.15.29: status text moved INSIDE the
                 widget_button (as widget_button_label), matching
                 the in-app ConnectButton's label-below-icon. This
                 view is kept in XML for ID-compatibility — code
                 still calls setTextViewText/setViewVisibility on
                 it — but visibility=gone hides it from the layout
                 so the right column starts with the uptime clock. -->
            <TextView
                android:id="@+id/widget_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="@string/widget_connect"
                android:textSize="12sp"
                android:textColor="@color/widget_text_secondary"
                android:singleLine="true" />

            <!-- Uptime — big monospace clock. visibility=GONE when
                 disconnected (set from VpnWidget.kt) so the right
                 column doesn't show a stale 00:00:00 below
                 "Disconnected". -->
            <TextView
                android:id="@+id/widget_uptime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textSize="20sp"
                android:fontFamily="monospace"
                android:textColor="@color/widget_text_primary"
                android:singleLine="true" />

            <!-- v0.9.15.x AmneziaWG Stage 1.4 — obfuscation pill.
                 Visible only when the active WG tunnel is the AWG
                 (DPI-evasion) variant. RemoteViews can't take a
                 dynamic background drawable so we tint the text
                 instead; small inline label is sufficient
                 affordance for the user to know the variant is in
                 effect. Visibility is toggled from VpnWidget.kt
                 based on variant=="amneziawg". -->
            <TextView
                android:id="@+id/widget_awg_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="◉ AmneziaWG"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#FF818CF8"
                android:singleLine="true"
                android:visibility="gone" />

            <!-- Connection name + chevron. Chevron is decorative
                 (RemoteViews can't make ImageView click-distinct);
                 a tap on this whole row goes to the root → opens
                 the app, where the picker lives. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="start|center_vertical">

                <TextView
                    android:id="@+id/widget_connection_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_name"
                    android:textSize="11sp"
                    android:textColor="@color/widget_text_secondary"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_widget_chevron_down"
                    android:contentDescription="@null" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 4. Protocol pills (WG / IPSec / OVPN). Each pill is a
         horizontal LinearLayout with icon + label text. Pill
         background switches between active/inactive drawables.
         The whole row is hidden by VpnWidget.kt when a pool is
         the active selection - pools mix members with different
         protocols, so a single-protocol picker UI is meaningless
         for them, mirroring the same gate on ConnectScreen.
         Per-pill visibility is also gated on the active
         connection's availableProtocols() in VpnWidget.kt
         (v0.9.14.68). -->
    <LinearLayout
        android:id="@+id/widget_protocol_pills_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:weightSum="4">

        <LinearLayout
            android:id="@+id/widget_protocol_awg"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/widget_protocol_button_inactive">

            <ImageView
                android:id="@+id/widget_protocol_awg_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_protocol_amneziawg_mono"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_protocol_awg_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/widget_protocol_amneziawg"
                android:textSize="10sp"
                android:textColor="@color/widget_text_primary"
                android:singleLine="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_protocol_wg"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="1dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/widget_protocol_button_inactive">

            <ImageView
                android:id="@+id/widget_protocol_wg_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_protocol_wireguard"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_protocol_wg_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/widget_protocol_wireguard"
                android:textSize="10sp"
                android:textColor="@color/widget_text_primary"
                android:singleLine="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_protocol_ipsec"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="1dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/widget_protocol_button_inactive">

            <ImageView
                android:id="@+id/widget_protocol_ipsec_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_protocol_strongswan"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_protocol_ipsec_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/widget_protocol_ipsec"
                android:textSize="10sp"
                android:textColor="@color/widget_text_primary"
                android:singleLine="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_protocol_ovpn"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/widget_protocol_button_inactive">

            <ImageView
                android:id="@+id/widget_protocol_ovpn_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_protocol_openvpn"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_protocol_ovpn_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/widget_protocol_openvpn"
                android:textSize="10sp"
                android:textColor="@color/widget_text_primary"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- 5. Endpoint text (small, centered, mono) -->
    <TextView
        android:id="@+id/widget_endpoint_center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text=""
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:textColor="@color/widget_text_secondary"
        android:singleLine="true"
        android:ellipsize="middle" />

    <!-- 6. Traffic cards (Download / Upload), side-by-side.
         v5 layout: sparkline INLINE next to the per-second speed
         value instead of in its own dedicated row. Saves ~16dp
         vertical per cards-row, redirected into the connect
         button's minHeight bump. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:orientation="vertical"
            android:padding="6dp"
            android:background="@drawable/widget_card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_arrow_download"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_status_connected" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="@string/widget_label_download"
                    android:textSize="10sp"
                    android:textColor="@color/widget_text_secondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_rx_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="0 B"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary"
                android:singleLine="true"
                android:ellipsize="end" />

            <!-- speed value + inline sparkline (right-aligned). The
                 sparkline ImageView gets a fixed width so it never
                 squeezes the speed text on tiny widgets. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_rx_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 B/s"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/widget_text_secondary"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <ImageView
                    android:id="@+id/widget_sparkline_rx"
                    android:layout_width="56dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:scaleType="fitXY"
                    android:contentDescription="@string/widget_sparkline_rx_description" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:orientation="vertical"
            android:padding="6dp"
            android:background="@drawable/widget_card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_arrow_upload"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="@string/widget_label_upload"
                    android:textSize="10sp"
                    android:textColor="@color/widget_text_secondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_tx_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="0 B"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary"
                android:singleLine="true"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/widget_tx_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 B/s"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/widget_text_secondary"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <ImageView
                    android:id="@+id/widget_sparkline_tx"
                    android:layout_width="56dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="4dp"
                    android:scaleType="fitXY"
                    android:contentDescription="@string/widget_sparkline_tx_description" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 7. VPN IP card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="5dp"
        android:background="@drawable/widget_card_background">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_label_vpn_ip"
            android:textSize="10sp"
            android:textColor="@color/widget_text_secondary"
            android:singleLine="true" />

        <TextView
            android:id="@+id/widget_vpn_ip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:text="—"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textColor="@color/widget_text_primary"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 8. Endpoint card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="5dp"
        android:background="@drawable/widget_card_background">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_label_endpoint"
            android:textSize="10sp"
            android:textColor="@color/widget_text_secondary"
            android:singleLine="true" />

        <TextView
            android:id="@+id/widget_endpoint_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:text="—"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textColor="@color/widget_text_primary"
            android:singleLine="true"
            android:ellipsize="middle" />
    </LinearLayout>

</LinearLayout>
