<?xml version="1.0" encoding="utf-8"?>
<!--
    Privycs VPN home-screen widget - Connect-screen mirror, take 2.

    Composition follows the app's ConnectScreen as a dominant anchor
    layout rather than flat stacked sections:

    1. Header row: connection name + server endpoint (compact).
    2. Big circular connect/disconnect button filling the remaining
       vertical space via layout_weight=1. Contains a tinted oval
       background plus two stacked ImageViews - one for the idle
       (disconnected) Privycs logo, one for the active protocol
       brand icon. Visibility is swapped at runtime so each icon
       keeps its intended colour treatment (idle logo gets a grey
       colorFilter, active protocol icon stays untinted to preserve
       WG/OVPN/IPSec brand colours).
    3. Protocol switcher row, active protocol's background swapped
       to widget_accent at runtime.
    4. Traffic row: download arrow + sparkline + value, followed by
       upload arrow + sparkline + value in a single line.

    Why @android:id/background on root: Android 12+ launcher applies
    its system widget chrome (rounded corners, Material You tint) to
    exactly this id; other ids get wrapped in a darker default
    container under our background, producing the "double frame"
    artifact seen prior to v0.9.3.10.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_background">

    <!-- Section 1: Header - connection name + server endpoint -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_header_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_primary"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_header_endpoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="10sp"
            android:textColor="@color/widget_text_secondary"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:ellipsize="middle" />
    </LinearLayout>

    <!-- Section 2: Big circular connect/disconnect button.
         layout_weight=1 absorbs any remaining vertical space so the
         widget has no dead pixels between sections. The FrameLayout
         is the click target (entire 68dp circle area) so the
         launcher cannot route mis-hits to the root background. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <FrameLayout
            android:id="@+id/widget_button_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <!-- Circle backdrop, tinted grey/accent at runtime -->
            <ImageView
                android:id="@+id/widget_button_bg"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:src="@drawable/widget_button_circle"
                android:contentDescription="@string/widget_description"
                android:scaleType="fitXY" />

            <!-- Idle state (disconnected): generic Privycs logo,
                 grey tinted at runtime via setColorFilter. -->
            <ImageView
                android:id="@+id/widget_button_icon_idle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_privycs_logo"
                android:scaleType="fitCenter" />

            <!-- Active state (connected): active protocol's brand
                 icon, untinted to preserve its colours. -->
            <ImageView
                android:id="@+id/widget_button_icon_active"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_protocol_wireguard"
                android:scaleType="fitCenter"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/widget_button_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/widget_status_disconnected"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/widget_status_disconnected"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Section 3: Protocol switcher -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:layout_marginTop="4dp">

        <ImageView
            android:id="@+id/widget_protocol_wg"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_protocol_wireguard"
            android:background="@drawable/widget_protocol_button_inactive"
            android:contentDescription="@string/widget_protocol_wireguard" />

        <ImageView
            android:id="@+id/widget_protocol_ovpn"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="1dp"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_protocol_openvpn"
            android:background="@drawable/widget_protocol_button_inactive"
            android:contentDescription="@string/widget_protocol_openvpn" />

        <ImageView
            android:id="@+id/widget_protocol_ipsec"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_protocol_strongswan"
            android:background="@drawable/widget_protocol_button_inactive"
            android:contentDescription="@string/widget_protocol_ipsec" />
    </LinearLayout>

    <!-- Section 4: Traffic - download + upload side by side -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_arrow_download"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/widget_status_connected" />

        <ImageView
            android:id="@+id/widget_sparkline_rx"
            android:layout_width="36dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="3dp"
            android:scaleType="fitXY"
            android:contentDescription="@string/widget_sparkline_rx_description" />

        <TextView
            android:id="@+id/widget_rx_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 B/s"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textColor="@color/widget_text_primary"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_arrow_upload"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/widget_accent"
            android:layout_marginStart="4dp" />

        <ImageView
            android:id="@+id/widget_sparkline_tx"
            android:layout_width="36dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="3dp"
            android:scaleType="fitXY"
            android:contentDescription="@string/widget_sparkline_tx_description" />

        <TextView
            android:id="@+id/widget_tx_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 B/s"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textColor="@color/widget_text_primary"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

</LinearLayout>
