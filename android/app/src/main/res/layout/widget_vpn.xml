<?xml version="1.0" encoding="utf-8"?>
<!--
    Privycs VPN home-screen widget - Connect-screen mirror (v4).

    User spec (v1.0.0): "Exactly like screenshots/widget.png, minus
    the bottom whitespace of the Connect screen." That means 9 rows
    stacked vertically, no large empty regions:

      1. Big circular status button (scales with widget height)
      2. Uptime (big monospace, centered)
      3. Connection name + chevron
      4. Protocol pills (WG / IPSec / OVPN, active one tinted)
      5. Endpoint text (small, centered, mono)
      6. Two traffic cards side-by-side (Download / Upload) -
         each: label, cumulative total, per-second speed, sparkline
      7. VPN IP card (label + value)
      8. Endpoint card (label + value)

    Kill-Switch Sinkhole state: when KillSwitchManager reports
    SINKHOLE, the circle gets tinted red (#DC2626 / red-600) and
    its icon swaps to ic_kill_switch_sinkhole so the user sees
    the active block state directly on the home screen without
    opening the app.

    RemoteViews whitelist constraints: LinearLayout, FrameLayout,
    ImageView, TextView allowed; no View/Space/CardView. Rounded
    cards are LinearLayouts with widget_card_background drawable.

    Root id = @android:id/background stays critical for Android 12+
    widget chrome (rounded corners, Material You tinting).
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_background">

    <!-- 1. Big circular status button.
         Gets weight=1 so it takes remaining space after fixed rows
         below claim their wrap_content heights. FrameLayout + fitCenter
         circle means a mostly-square circle even on wide widgets. -->
    <LinearLayout
        android:id="@+id/widget_button_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:minHeight="88dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/widget_button_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_button_circle"
                android:scaleType="fitCenter"
                android:contentDescription="@string/widget_description"
                android:adjustViewBounds="true" />

            <ImageView
                android:id="@+id/widget_button_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:padding="14dp"
                android:src="@drawable/ic_protocol_wireguard"
                android:scaleType="fitCenter" />
        </FrameLayout>
    </LinearLayout>

    <!-- 2. Uptime - big monospace text, centered -->
    <TextView
        android:id="@+id/widget_uptime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="00:00:00"
        android:textSize="18sp"
        android:fontFamily="monospace"
        android:textColor="@color/widget_text_primary"
        android:singleLine="true" />

    <!-- 3. Connection name + chevron.
         Chevron is decorative (not clickable in RemoteViews - click
         falls through to the root body → open-app intent), purely
         to signal "this is the active connection you could switch". -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/widget_connection_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="12sp"
            android:textColor="@color/widget_text_primary"
            android:singleLine="true"
            android:ellipsize="end" />

        <ImageView
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_widget_chevron_down"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- 4. Protocol pills (WG / IPSec / OVPN). Each pill is a
         horizontal LinearLayout with icon + label text. Pill
         background switches between active/inactive drawables. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:weightSum="3">

        <LinearLayout
            android:id="@+id/widget_protocol_wg"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/widget_protocol_button_inactive">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_protocol_wireguard"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_protocol_wg_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/widget_protocol_wireguard"
                android:textSize="10sp"
                android:textColor="@color/widget_text_primary"
                android:singleLine="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_protocol_ipsec"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="1dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/widget_protocol_button_inactive">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_protocol_strongswan"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_protocol_ipsec_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/widget_protocol_ipsec"
                android:textSize="10sp"
                android:textColor="@color/widget_text_primary"
                android:singleLine="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_protocol_ovpn"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/widget_protocol_button_inactive">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_protocol_openvpn"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/widget_protocol_ovpn_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/widget_protocol_openvpn"
                android:textSize="10sp"
                android:textColor="@color/widget_text_primary"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- 5. Endpoint text (small, centered, mono) -->
    <TextView
        android:id="@+id/widget_endpoint_center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text=""
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:textColor="@color/widget_text_secondary"
        android:singleLine="true"
        android:ellipsize="middle" />

    <!-- 6. Two traffic cards (Download / Upload) side by side. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:orientation="vertical"
            android:padding="6dp"
            android:background="@drawable/widget_card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_arrow_download"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_status_connected" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="@string/widget_label_download"
                    android:textSize="10sp"
                    android:textColor="@color/widget_text_secondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_rx_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="0 B"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_rx_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 B/s"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textColor="@color/widget_text_secondary"
                android:singleLine="true"
                android:ellipsize="end" />

            <ImageView
                android:id="@+id/widget_sparkline_rx"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_marginTop="2dp"
                android:scaleType="fitXY"
                android:contentDescription="@string/widget_sparkline_rx_description" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:orientation="vertical"
            android:padding="6dp"
            android:background="@drawable/widget_card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_arrow_upload"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="@string/widget_label_upload"
                    android:textSize="10sp"
                    android:textColor="@color/widget_text_secondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_tx_total"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="0 B"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_tx_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 B/s"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textColor="@color/widget_text_secondary"
                android:singleLine="true"
                android:ellipsize="end" />

            <ImageView
                android:id="@+id/widget_sparkline_tx"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_marginTop="2dp"
                android:scaleType="fitXY"
                android:contentDescription="@string/widget_sparkline_tx_description" />
        </LinearLayout>
    </LinearLayout>

    <!-- 7. VPN IP card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="5dp"
        android:background="@drawable/widget_card_background">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_label_vpn_ip"
            android:textSize="10sp"
            android:textColor="@color/widget_text_secondary"
            android:singleLine="true" />

        <TextView
            android:id="@+id/widget_vpn_ip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:text="—"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textColor="@color/widget_text_primary"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 8. Endpoint card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="5dp"
        android:background="@drawable/widget_card_background">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_label_endpoint"
            android:textSize="10sp"
            android:textColor="@color/widget_text_secondary"
            android:singleLine="true" />

        <TextView
            android:id="@+id/widget_endpoint_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:text="—"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textColor="@color/widget_text_primary"
            android:singleLine="true"
            android:ellipsize="middle" />
    </LinearLayout>

</LinearLayout>
