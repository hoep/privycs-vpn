<?xml version="1.0" encoding="utf-8"?>
<!--
    Privycs VPN compact home-screen widget (2x2).

    Strips everything from the main widget_vpn.xml down to just the
    big circular connect button. Tap = toggle the active connection
    (same ACTION_TOGGLE handler as the main widget). Intended for
    home-screens where the user wants a one-tap connect/disconnect
    affordance without sacrificing a 4x3 grid block.

    Layout mirrors the Section 1 of widget_vpn.xml byte-for-byte so
    VpnWidget's renderConnectButton helper can drive both layouts
    via the same view-IDs (widget_button_*, widget_button_halo,
    widget_button_bg, widget_button_icon).

    Click targets:
      - widget_button (entire fixed square)  → ACTION_TOGGLE
      - android.R.id.background (everywhere else) → open MainActivity

    Root id stays @android:id/background for Android 12+ widget
    chrome (rounded corners, Material You tinting).
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="4dp"
    android:background="@drawable/widget_background">

    <FrameLayout
        android:id="@+id/widget_button"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center">

        <ImageView
            android:id="@+id/widget_button_halo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_margin="-8dp"
            android:src="@drawable/widget_button_halo"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="@null"
            android:adjustViewBounds="true" />

        <ImageView
            android:id="@+id/widget_button_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_button_circle"
            android:scaleType="fitCenter"
            android:contentDescription="@string/widget_description"
            android:adjustViewBounds="true" />

        <ImageView
            android:id="@+id/widget_button_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:padding="28dp"
            android:src="@drawable/ic_protocol_wireguard"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />
    </FrameLayout>
</LinearLayout>
