<?xml version="1.0" encoding="utf-8"?>
<!--
    AmneziaWG icon — circled-A silhouette, single tintable vector path.
    Designed to match the desktop ProtocolIcon.vue inline SVG byte-for-
    byte so the brand mark renders identically on Android, Linux,
    macOS, and Windows.

    Composition (even-odd fill):
      1. Outer circle  — radius 10, filled
      2. Inner circle  — radius 8.4, even-odd subtracts → leaves a ring
      3. "A" outer    — filled letter shape inside the ring's hole
      4. "A" counter  — inner triangle at apex, even-odd subtracts
                        → the natural counter of a capital A

    No horizontal crossbar — kept the symbology purely circular per
    design feedback. Fill color is controlled by the Compose Icon's
    tint cascade; Android's androidColor is set to @android:color/white
    so the tint replaces it cleanly.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
