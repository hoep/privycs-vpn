<?xml version="1.0" encoding="utf-8"?>
<!--
    Monochrome shield glyph used by surfaces that force single-color
    tinting (Quick Settings tile, status bar notifications). Based on
    the classic "security shield" outline so the shape reads as
    "VPN / protection" at a glance even without brand color.

    Intentionally not a Privycs-branded shield-with-P - the "P" glyph
    needs internal negative space which does not survive forced
    single-color tint (the tile's tint makes the whole thing one
    color, erasing any subtle internal shapes). A clean filled
    shield reads cleaner at 24dp than a crowded shield+glyph.

    Drawn at 24dp/24viewport which is the Material baseline; tile
    icons get auto-scaled to 28-32dp by the system anyway.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,1 L3,5 v6 c0,5.55 3.84,10.74 9,12 c5.16,-1.26 9,-6.45 9,-12 V5 L12,1 z" />
</vector>
