<?xml version="1.0" encoding="utf-8"?>
<!--
    Privycs VPN home-screen widget configuration.

    Size:
    - minWidth/minHeight 110dp: roughly 2x2 launcher cells on most
      devices. Enough for icon + status + toggle button without
      clipping on the densest launchers (Pixel, Samsung One UI).
    - targetCellWidth/Height (API 31+): preferred layout is 2x3,
      giving room for connection name + protocol + uptime without
      the user needing to resize.
    - resizeMode horizontal|vertical: user can make it wider or
      taller if they want more breathing room.

    previewImage:
    - @drawable/ic_privycs_logo (the branded shield + P) so the
      widget picker shows "this is a Privycs widget" at a glance
      instead of the generic Android lock-icon it used to show.

    updatePeriodMillis:
    - 0 disables automatic periodic updates since our service
      drives updates via sendStatusUpdate broadcast whenever state
      changes. The previous 600000ms (10min) was both too slow
      (10min between auto-refreshes when service is dead) and
      irrelevant (broadcast path covers the signal). Value 0 also
      saves battery.
-->
<appwidget-provider
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:initialLayout="@layout/widget_vpn"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description"
    android:previewImage="@drawable/ic_privycs_logo"
    android:previewLayout="@layout/widget_vpn"
    tools:targetApi="31" />
