<?xml version="1.0" encoding="utf-8"?>
<!--
    Privycs VPN home-screen widget configuration.

    Size (4x3 cells):
    - Widget renders three stacked sections: connect toggle + status,
      protocol switcher row, traffic sparklines with values. 4x3 is
      the minimum that fits all three without clipping on dense
      launchers (Pixel, Samsung One UI).
    - 250x180dp corresponds to ~4x3 cells on most launchers.
    - minResizeWidth/Height lock the minimum user-resize so the
      sparkline bitmaps stay legible if the user shrinks the widget.

    previewImage:
    - @drawable/ic_privycs_logo shows "this is a Privycs widget" in
      the launcher's widget picker.

    updatePeriodMillis = 0:
    - Service-driven broadcast pushes updates whenever state changes
      (status transitions, traffic samples every 1-2s). System-
      scheduled updates would be wasteful.
-->
<appwidget-provider
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:initialLayout="@layout/widget_vpn"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="180dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description"
    android:previewImage="@drawable/ic_privycs_logo"
    android:previewLayout="@layout/widget_vpn"
    tools:targetApi="31" />
