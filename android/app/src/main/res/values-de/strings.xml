    <!-- NetworkRulesScreen -->
    <string name="netrules_screen_title">On-Demand &amp; Netzwerkregeln</string>
    <string name="netrules_back">Zurück</string>
    <string name="netrules_add_rule">Regel hinzufügen</string>
    <string name="netrules_rules_header">REGELN — VON OBEN NACH UNTEN GEPRÜFT</string>
    <string name="netrules_precedence_title">So entscheidet dieser Bildschirm</string>
    <string name="netrules_precedence_body">Bei jedem Netzwerkwechsel werden die untenstehenden Regeln von oben nach unten geprüft — die erste Regel, die auf das aktuelle Wi-Fi- oder Mobilfunknetz passt, gewinnt. Passt keine Regel, gilt das unten verankerte Standardverhalten. Regeln werden nur ausgewertet, solange Connect-on-Demand aktiviert ist.</string>
    <string name="netrules_empty_title">Noch keine Regeln</string>
    <string name="netrules_empty_body">Jedes Netzwerk fällt auf das untenstehende Standardverhalten zurück. Füge mit der Schaltfläche + eine Regel hinzu, um es für eine bestimmte Wi-Fi-SSID, BSSID oder einen Netzwerktyp zu überschreiben — und dieses Netzwerk an einen Pool, eine Verbindung oder kein VPN weiterzuleiten.</string>
    <string name="netrules_fallback_header">RÜCKFALL — WENN KEINE REGEL PASST</string>
    <string name="netrules_default_behaviour_title">Standardverhalten</string>
    <string name="netrules_default_behaviour_subtitle">Connect-on-Demand — gilt für jedes Netzwerk, auf das keine Regel oben passt</string>
    <string name="netrules_edit">Bearbeiten</string>
