    <!-- AlwaysOnDisconnectSheet -->
    <string name="alwayson_sheet_title">Disconnetti VPN</string>
    <string name="alwayson_sheet_body">L\'impostazione di sistema Android \'VPN sempre attiva\' è abilitata per Privycs. Android riconnetterà automaticamente il tunnel ogni volta che viene fermato. Scegli come vuoi disconnetterti:</string>
    <string name="alwayson_pause_5">Pausa di 5 minuti</string>
