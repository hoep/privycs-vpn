<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- v0.9.15.31: Android 13+ Wi-Fi access. Granted alongside
         ACCESS_FINE_LOCATION enables SSID reads without needing
         location services to be ON (which is otherwise the
         universal pre-13 requirement). usesPermissionFlags
         neverForLocation makes Play Store policy compliance clear:
         we use it only for SSID-rule matching, never to derive
         user location. Pre-Android-13 devices silently ignore
         this permission. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- v0.9.15.75: ACCESS_BACKGROUND_LOCATION is intentionally NOT
         declared in the open-test build. Declaring it triggers
         Google Play's background-location declaration form + demo-
         video review gate, which would block the open-test launch.
         SSID-based Connect-on-Demand runs foreground-only until then
         — NetworkMonitor degrades gracefully (the OS redacts the SSID
         to a backgrounded app without this permission, it does not
         error). To re-enable for the production release: add this
         <uses-permission> line back AND flip BACKGROUND_LOCATION_ENABLED
         in MainActivity.kt, then prepare the Play Console form +
         video.
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    -->
    <!-- Required for reliable Connect-on-Demand reaction in Doze /
         App Standby (v0.9.15.24). Without battery-optimization
         exemption Android defers our NetworkCallback delivery to
         the next ~15 min maintenance window, so WiFi changes that
         should trigger VPN connect/disconnect don't fire until the
         user wakes the device. The exemption is a Google Play
         acceptable use case for VPN apps with auto-connect rules.
         User must grant via the system dialog (we prompt from
         SettingsScreen when COD is enabled). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- v0.9.15.75: pool rotation + the OEM-task-kill self-restart
         use setAndAllowWhileIdle (inexact, Doze-friendly), which
         needs NO alarm permission. The exact-alarm permissions were
         dropped: USE_EXACT_ALARM is Play-restricted to alarm-clock /
         calendar apps, and SCHEDULE_EXACT_ALARM is unnecessary once
         the alarms are inexact. Both use cases tolerate the OS
         batching window (intervals are minutes; drift never
         compounds — the receiver re-arms the next cycle on fire). -->

    <application
        android:name=".PrivycsApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PrivycsVPN"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.PrivycsVPN">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- v0.9.15.75: the VIEW/.conf file-association filter
                 was removed — it only matched file:// URIs (modern
                 share sheets hand out content://) AND MainActivity
                 never consumed intent.data, so "open a .conf with
                 Privycs" silently did nothing. Config import runs via
                 the in-app picker in AddConnectionScreen. A proper,
                 device-tested file association can return later. -->
        </activity>

        <service
            android:name=".service.PrivycsVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <!-- v0.9.14.77: stopWithTask="false" makes our intent
                 explicit. For foreground services it's the implicit
                 default, but on aggressive OEMs (Samsung One UI,
                 Xiaomi MIUI, Huawei EMUI, Oppo, Vivo) the system
                 task-killer ignores the implicit default and
                 terminates the service on user-swipe-from-recents
                 anyway. The explicit attribute combined with the
                 onTaskRemoved restart-self handler in
                 PrivycsVpnService is the industry-standard mitigation
                 for keep-alive VPN apps on those OEMs. -->
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <!-- v0.9.15.75: special-use subtype for the
                 foregroundServiceType="specialUse" service, matching
                 the vendored OpenVPN/strongSwan services. Play reads
                 this for specialUse foreground services at review. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
        </service>

        <!-- v0.9.15.46: the explicit wireguard-android
             `GoBackend$VpnService` declaration was removed alongside
             the Maven dependency drop. The AmneziaWG submodule's
             `org.amnezia.awg.backend.GoBackend$VpnService` (merged
             from amneziawg-android's own manifest) now serves both
             AmneziaWG and vanilla WireGuard tunnels — see app/
             build.gradle.kts dependency comment and
             PrivycsVpnService.amneziaTunnel doc for the
             switch-to-WG-hangs-90s asymmetry-elimination rationale. -->

        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Pool rotation alarms — fired by AlarmManager from
             PoolRotationScheduler. Not exported (only the system's
             AlarmManager triggers it via the registered PendingIntent). -->
        <receiver
            android:name=".receiver.PoolAlarmReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.privycs.vpn.action.POOL_PRE_WARM" />
                <action android:name="com.privycs.vpn.action.POOL_ROTATE" />
            </intent-filter>
        </receiver>

        <!-- v0.9.14.97: process-death-surviving network-change wake.
             Fired by the PendingIntent-based ConnectivityManager
             callback registered in CodWakeRegistrar (API 31+).
             Android delivers this Intent even when our process has
             been killed by the OEM battery-killer; the framework
             spawns a fresh process to handle it, which then
             re-evaluates Connect-on-Demand rules and fires any
             pending connect/disconnect within ~2 s. Not exported —
             only the framework's PendingIntent-callback dispatcher
             can target this receiver. -->
        <receiver
            android:name=".receiver.CodWakeReceiver"
            android:exported="false"
            android:enabled="true" />

        <!-- Quick Settings Tile -->
        <service
            android:name=".tile.VpnQuickSettingsTile"
            android:exported="true"
            android:icon="@drawable/ic_privycs_shield"
            android:label="@string/vpn_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Home Screen Widget (4x3, full UI) -->
        <receiver
            android:name=".widget.VpnWidget"
            android:exported="true">
            <!-- v0.9.15.74 (B-5 hardening): TOGGLE / SWITCH_PROTOCOL
                 are intentionally NOT in the intent-filter. The
                 widget's own control PendingIntents are explicit-
                 component, so they need no filter; keeping the
                 actions out stops implicit broadcasts from foreign
                 apps from even reaching onReceive. onReceive
                 additionally token-checks every control broadcast. -->
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.privycs.vpn.widget.STATUS_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_vpn_info" />
        </receiver>

        <!-- Home Screen Widget (2x2, connect button only). The toggle
             intent target is VpnWidget (not this receiver) so the
             ACTION_TOGGLE handler stays centralised; this receiver
             only listens for ACTION_APPWIDGET_UPDATE + the service-
             broadcast STATUS_CHANGED so its on-screen instances
             redraw alongside the main widget on state changes. -->
        <receiver
            android:name=".widget.VpnWidgetCompact"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.privycs.vpn.widget.STATUS_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_vpn_compact_info" />
        </receiver>

    </application>

</manifest>
