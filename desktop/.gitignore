build/bin
node_modules
frontend/dist
# Country.mmdb in geoip/ is a placeholder committed with the repo so
# go:embed always compiles. CI's preBuildHook (scripts/fetch-geoip.sh)
# overwrites it before `wails build` links - DO NOT gitignore the
# placeholder itself. The fetch script also deposits a copy at
# assets/geoip/ for the disk-fallback lookup path; that copy is large
# (~6 MB) and stays out of source control.
assets/geoip/Country.mmdb

# Compiled app binaries — release builds are produced by CI, never
# committed. desktop/desktop and desktop/desktop.exe were committed
# by accident and removed in the pre-public-release cleanup.
desktop
desktop.exe

# Local dev binary from `go build ./cmd/license-gen` — the CLI tool
# source lives under cmd/license-gen/ (tracked); only the compiled
# binary in desktop/ is excluded. Anchor with leading slash so the
# rule doesn't match the source dir.
/license-gen
/license-gen.exe

# npm build-cache fingerprint.
frontend/package.json.md5

# license-gen CLI source lives in the private docs repo
# (privycs-vpn-private-docs/license-gen-tool/). Dropping the source back
# into desktop/cmd/license-gen/ for `go run` is fine for local dev, but
# never commit it — exposes the signing wrapper publicly.
cmd/license-gen/
